{
  "name": "@aheart-ui/ai",
  "version": "1.1.0",
  "description": "Vue 3 AI interface components for Aheart UI.",
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "es/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./style.css": "./es/style.css",
    "./es/*": "./es/*",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json",
    "./actions": {
      "types": "./es/actions/index.d.ts",
      "import": "./es/actions/index.js",
      "require": "./lib/actions/index.js"
    },
    "./actions/style.css": "./es/actions/style.css",
    "./attachments": {
      "types": "./es/attachments/index.d.ts",
      "import": "./es/attachments/index.js",
      "require": "./lib/attachments/index.js"
    },
    "./attachments/style.css": "./es/attachments/style.css",
    "./bubble": {
      "types": "./es/bubble/index.d.ts",
      "import": "./es/bubble/index.js",
      "require": "./lib/bubble/index.js"
    },
    "./bubble/style.css": "./es/bubble/style.css",
    "./conversations": {
      "types": "./es/conversations/index.d.ts",
      "import": "./es/conversations/index.js",
      "require": "./lib/conversations/index.js"
    },
    "./conversations/style.css": "./es/conversations/style.css",
    "./form": {
      "types": "./es/form/index.d.ts",
      "import": "./es/form/index.js",
      "require": "./lib/form/index.js"
    },
    "./form/style.css": "./es/form/style.css",
    "./process": {
      "types": "./es/process/index.d.ts",
      "import": "./es/process/index.js",
      "require": "./lib/process/index.js"
    },
    "./process/style.css": "./es/process/style.css",
    "./prompts": {
      "types": "./es/prompts/index.d.ts",
      "import": "./es/prompts/index.js",
      "require": "./lib/prompts/index.js"
    },
    "./prompts/style.css": "./es/prompts/style.css",
    "./sender": {
      "types": "./es/sender/index.d.ts",
      "import": "./es/sender/index.js",
      "require": "./lib/sender/index.js"
    },
    "./sender/style.css": "./es/sender/style.css",
