      "types": "./es/welcome/index.d.ts",
      "import": "./es/welcome/index.js",
      "require": "./lib/welcome/index.js"
    },
    "./welcome/style.css": "./es/welcome/style.css",
    "./chat-panel": {
      "types": "./es/chat-panel/index.d.ts",
      "import": "./es/chat-panel/index.js",
      "require": "./lib/chat-panel/index.js"
    },
    "./chat-panel/style.css": "./es/chat-panel/style.css",
    "./agent-workbench": {
      "types": "./es/agent-workbench/index.d.ts",
      "import": "./es/agent-workbench/index.js",
      "require": "./lib/agent-workbench/index.js"
    },
    "./agent-workbench/style.css": "./es/agent-workbench/style.css",
    "./chat": {
      "types": "./es/chat/index.d.ts",
      "import": "./es/chat/index.js",
      "require": "./lib/chat/index.js"
    },
    "./chat/style.css": "./es/chat/style.css",
    "./agent": {
      "types": "./es/agent/index.d.ts",
      "import": "./es/agent/index.js",
      "require": "./lib/agent/index.js"
    },
    "./agent/style.css": "./es/agent/style.css",
    "./workbench": {
      "types": "./es/agent-workbench/index.d.ts",
      "import": "./es/agent-workbench/index.js",
      "require": "./lib/agent-workbench/index.js"
    },
    "./workbench/style.css": "./es/agent-workbench/style.css",
    "./full": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./full.css": "./es/style.css"
  },
  "files": [
    "es",
    "lib"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --environment jsdom",
    "test:coverage": "vitest run --environment jsdom --coverage"
  },
  "keywords": [
    "aheart-ui",
    "vue3",
    "ai",
    "chat",
    "agent",
    "form"
  ],
  "author": "小凡",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzfdhr/aheart-ui.git",
    "directory": "packages/ai"
  },
  "homepage": "https://github.com/wzfdhr/aheart-ui#readme",
  "bugs": {
    "url": "https://github.com/wzfdhr/aheart-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "aheart-ui": "workspace:^1.1.0",
    "vue": ">=3.5.0 <4"
  },
  "dependencies": {
    "@aheart-ui/dnd": "workspace:^1.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitest/coverage-v8": "1.6.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^24.1.1",
    "vite": "^5.0.12",
    "vite-plugin-dts": "^3.7.2",
    "vitest": "^1.6.1",
    "vue": "^3.5.38",
    "vue-tsc": "^2.0.29"
  }
}
